# ============================================================
# Rasidul Tech Point - Environment Configuration (EXAMPLE)
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# Application
APP_NAME="Rasidul Tech Point"
APP_ENV=local            # local | production
APP_DEBUG=true           # MUST be false in production
APP_URL=http://localhost:8090
APP_TIMEZONE=Asia/Dhaka  # presentation timezone; storage is always UTC
APP_KEY=

# Database (MySQL 8.x / MariaDB 10.4+)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rasidul_tech_point
DB_USERNAME=rasidul_user
DB_PASSWORD=secret

# Session / security
SESSION_NAME=rtp_session
SESSION_LIFETIME=7200    # seconds (2 hours)
SESSION_SECURE=false     # MUST be true behind HTTPS in production
SESSION_HTTPONLY=true

# Login rate limiting
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_SECONDS=900  # 15 minutes

# Mail (log driver writes emails to storage/logs/mail.log)
MAIL_DRIVER=log          # log | null (production: configure a real transport)
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Rasidul Tech Point"

# Uploads
UPLOAD_MAX_BYTES=4194304 # 4 MB

# Backups & restore (Prompt 40) — see docs/BACKUPS.md
APP_KEY=                 # REQUIRED for secrets encryption (AES-256-CBC). 32+ random bytes.
BACKUP_DIR=              # default: storage/backups/ (MUST be outside public/)
BACKUP_RETENTION_DAYS=30 # 0 = no rotation (everything kept)
MYSQLDUMP_BIN=           # default: PATH lookup; set when system mysqldump is not on PATH
MYSQL_BIN=               # default: PATH lookup
TAR_BIN=                 # default: /usr/bin/tar

# Cron / scheduled tasks
# 0 2 * * *  cd /var/www/rtp && /usr/bin/php bin/backup.php --retention=30 >> storage/logs/cron-backup.log 2>&1
# 0 3 * * *  cd /var/www/rtp && /usr/bin/php bin/migrate.php status | grep -q 'No pending' || echo "Pending migrations" | mail -s 'RTP ALERT' ops@example.com
# 0 4 * * *  cd /var/www/rtp && /usr/bin/php bin/restore.php --list | mail -s 'RTP backups' ops@example.com
# 0 * * * *  cd /var/www/rtp && /usr/bin/php -r 'require "bootstrap/app.php"; App\Services\NotificationService::retryFailed();' >> storage/logs/cron-notif-retry.log 2>&1
